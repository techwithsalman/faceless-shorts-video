# ==============================================================================
# Beyond History / Faceless Shorts Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set environment variables in your system profile.
# No real secrets or API keys are required (100% Free & Local).

# 1. AI Model Cache Directory
# On machines with multiple drives, specify a secondary drive (e.g. D:\faceless-shorts-ai\cache).
# If left commented or unset, the engine defaults to %USERPROFILE%\.faceless-shorts\cache.
HF_HOME=~/.faceless-shorts/cache
TORCH_HOME=~/.faceless-shorts/cache/torch
TRANSFORMERS_CACHE=~/.faceless-shorts/cache

# 2. Engine Home & Kokoro TTS Weights
FACELESS_HOME=~/.faceless-shorts

# 3. Hardware Device Selection (auto, cpu, cuda)
FACELESS_DEVICE=auto

# 4. Default Documentary Voice Timbre
# Supported Kokoro-82M voices:
#   bm_george   (UK male, solemn documentary - default for Beyond History)
#   bm_fable    (UK male, dynamic storyteller)
#   af_heart    (US female, warm & expressive)
#   am_michael  (US male, steady explainer)
DEFAULT_VOICE=bm_george

# 5. Default Image Model
# Supported open-weight models:
#   sd-turbo         (default, fast 1-2 step CPU inference in 8-15 s)
#   lcm-dreamshaper  (4-step high quality)
#   realistic-vision (SD 1.5 photorealistic)
#   sdxl-turbo       (SDXL high resolution)
DEFAULT_IMAGE_MODEL=sd-turbo
